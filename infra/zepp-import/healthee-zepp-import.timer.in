# Healthee nightly Zepp import timer. Installed by `scripts/zepp-nightly install`.

[Unit]
Description=Run the Healthee Zepp import every night

[Timer]
OnCalendar=*-*-* {{TIME}}:00 {{ZONE}}
# If the server was off at that time, run once when it is back.
Persistent=true
RandomizedDelaySec=300
Unit=healthee-zepp-import.service

[Install]
WantedBy=timers.target
