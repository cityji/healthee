#!/usr/bin/env python3
"""Run the Zepp import every night on a Linux server with systemd.

    sudo python3 scripts/zepp-nightly install --time 23:30 --no-routes
    zepp-nightly status

Standard library only. See infra/zepp-import/README.md.
"""

import sys
from pathlib import Path

if sys.version_info < (3, 10):  # noqa: UP036 - the one guard that must run on an old Python
    sys.exit("zepp-nightly needs Python 3.10 or newer and this is " + sys.version.split()[0])

sys.path.insert(0, str(Path(__file__).resolve().parent))

from zepp_import.nightly import main  # noqa: E402

sys.exit(main())
