#!/usr/bin/env python3
"""Import workouts recorded in the Zepp app into a Healthee server.

    python3 scripts/zepp-import --dry-run
    python3 scripts/zepp-import

Standard library only: nothing to install. See scripts/zepp_import/README.md.
"""

import sys
from pathlib import Path

if sys.version_info < (3, 11):  # noqa: UP036 - the one guard that must run on an old Python
    sys.exit("zepp-import needs Python 3.11 or newer; this is Python " + sys.version.split()[0])

sys.path.insert(0, str(Path(__file__).resolve().parent))

from zepp_import.cli import main  # noqa: E402

sys.exit(main())
